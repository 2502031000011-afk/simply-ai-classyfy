<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>30 Dogs</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background: #f5f5f5;
        }

        h1 {
            color: #333;
        }

        #dogImage {
            max-width: 90%;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        button {
            margin-top: 20px;
            padding: 12px 25px;
            font-size: 16px;
            cursor: pointer;
            border: none;
            border-radius: 8px;
            background: #333;
            color: white;
        }
    </style>
</head>

<body>

    <h1>🐶 30 Cute Dogs 🐶</h1>

    <img id="dogImage" src="30-dogs.png" alt="30 dogs">

    <br>

    <button onclick="changeTitle()">Click Me</button>

    <script>
        function changeTitle() {
            document.querySelector("h1").innerText =
                "🐕 Look at These 30 Dogs! 🐕";
        }
    </script>

</body>
</html>
